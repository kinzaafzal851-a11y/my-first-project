import numpy as np
from sklearn.cluster import KMeans
#sample dataset
X= np.array([
[1,2],
[2,3],
[3,3],
[8,8],
[9,8],
[8,9]]) 
model=KMeans(n_clusters=2,
   random_state=42, n_init=10 )
model.fit(X)

print("Cluster Labels:")
print(model.labels_)
print("Cluster Centers:")
print(model.cluster_centers_)